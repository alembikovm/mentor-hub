# Clerk: Dashboard -> API keys -> "Show JWT public key" / JWKS URL
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Optional, recommended in production: your Clerk Frontend API URL
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Claude vision analysis
ANTHROPIC_API_KEY=sk-ant-xxx
ANALYSIS_MODEL=claude-haiku-5-5
ANALYSIS_EFFORT=high

# SQLite by default; for Postgres: postgresql+asyncpg://user:pass@host/db (and `uv add asyncpg`)
DATABASE_URL=sqlite+aiosqlite:///./mentor_hub.db
UPLOAD_DIR=./uploads
